#-----------------------
# Database Configuration
#-----------------------
# Creating database user
create user 'academyUser'@'localhost' identified by 'academyPass';

# Creating database
create database academyDatabase;

# Creating table on academyDatabase
use academyDatabase;

CREATE TABLE students (
    name VARCHAR(255),
    age INT,
    id VARCHAR(30),
    class VARCHAR(100),
    Mathfees INT,
    Phyfees INT,
    Biofees INT,
    Chemfees INT,
    Urdufees INT,
    Quranfees INT
);

# Grant Privileges to user on the database
GRANT INSERT, SELECT, DELETE ON academyDatabase.* TO 'academyUser'@'localhost';

flush privileges;

# Add English Column
ALTER TABLE students
ADD COLUMN Engfees INT;


